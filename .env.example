# ============================================
# ERP Platform - Environment Variables Template
# Copy this file to services/api/.env for the API/seed development scripts
# NEVER commit .env files with real secrets
# ============================================

# Node
NODE_ENV=development
PORT=3000

# Local MongoDB; use a replica set for atomic business/outbox/inbox transactions.
# Atlas development is optional: configure its URI privately, never in tests.
MONGODB_URI=mongodb://127.0.0.1:27017/erp_dev?replicaSet=rs0
MONGODB_DB_NAME=erp_dev

# JWT
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Empty/short/example secrets intentionally fail startup, including development.
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Opaque refresh tokens use hashes, not a second signing secret. Absolute TTL <=30d.
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Security
AUTH_BRUTE_FORCE_MAX=5
MONGO_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=1
SEED_DEV=false

# Worker (export these variables before starting worker; it does not load API .env)
REDIS_URL=redis://127.0.0.1:6379
MAX_CONCURRENT_JOBS=5
MAX_RETRIES=5
RETRY_DELAY_MS=1000
JOB_INTERVAL_MS=5000
SCHEDULED_JOB_INTERVAL_MS=10000

# Outbox
OUTBOX_POLL_INTERVAL_MS=1000

# Audit/event retention is an operational policy, not an implemented env switch.
# Session rows purge seven days after absolute expiry; no business/audit data TTL.

# Multi-tenant
TENANT_HEADER=x-tenant-id
