# ============================================
# ERP Platform - Environment Variables Template
# Copy this file to .env.local for local development
# NEVER commit .env files with real secrets
# ============================================

# Node
NODE_ENV=development
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/erp?retryWrites=true&w=majority
MONGODB_DB_NAME=erp_dev

# JWT
JWT_SECRET=change-me-in-production-use-a-very-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN_WEB=http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Security
BCRYPT_ROUNDS=12

# Mail (optional)
MAIL_URL=smtp://localhost:3000
MAIL_FROM=noreply@erp.local

# Observability
LOG_LEVEL=debug
OTEL_EXPORTER=console

# Feature Flags
FEATURE_FLAGS_URL=http://localhost:3000/api/v1/feature-flags

# Worker
WORKER_CONCURRENCY=5
WORKER_QUEUE_PREFIX=erp:queue:

# Outbox
OUTBOX_POLL_INTERVAL_MS=1000

# Audit
AUDIT_RETENTION_DAYS=2555

# Multi-tenant
DEFAULT_TENANT_ID=
TENANT_HEADER=x-tenant-id
