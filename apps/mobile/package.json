{
  "name": "@erp/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "dev": "react-native start",
    "prebundle:android": "node -e \"require('node:fs').mkdirSync('dist', {recursive: true})\"",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output dist/index.android.bundle --assets-dest dist/assets"
  },
  "dependencies": {
    "@erp/api-client": "*",
    "@erp/auth": "*",
    "@erp/contracts": "*",
    "@erp/design-tokens": "*",
    "@erp/localization": "*",
    "@erp/permissions": "*",
    "@erp/ui": "*",
    "@erp/utils": "*",
    "@erp/validation": "*",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.27",
    "react-native-screens": "^3.31.1",
    "react-native-safe-area-context": "^4.10.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/react": "^18.2.48",
    "@react-native-community/cli": "13.6.9",
    "@react-native/babel-preset": "0.74.87",
    "@react-native/metro-config": "0.74.87"
  }
}
