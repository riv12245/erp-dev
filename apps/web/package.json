{
  "name": "@erp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --reporter=verbose --passWithNoTests"
  },
  "dependencies": {
    "@erp/api-client": "*",
    "@erp/auth": "*",
    "@erp/contracts": "*",
    "@erp/design-tokens": "*",
    "@erp/localization": "*",
    "@erp/permissions": "*",
    "@erp/ui": "*",
    "@erp/utils": "*",
    "@erp/validation": "*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native-web": "~0.19.13",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.0",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "eslint": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0"
  }
}