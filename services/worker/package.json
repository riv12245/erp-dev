    "uuid": "^10.0.0",
    "@erp/shared": "*",
    "@erp/outbox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "mongodb-memory-server": "^10.1.0"
